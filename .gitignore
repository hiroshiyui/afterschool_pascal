build/
# The release process configures a from-scratch tree beside it
# (.claude/skills/release-engineering), and a coverage one beside that
# (.claude/skills/code-review).
build-*/
*.o
*.ll
# ...except the seed, which is a committed compiler and the one thing that lets
# this repository build itself (ADR-0085). It was silently skipped by `git add`
# for one commit, and a clean clone could not be built.
!seed/*.ll
*.s
__pycache__/
*.pyc

# The BSI validation suite is fetched, never committed (tests/bsi/fetch.sh).
tests/bsi/suite/

# The standards themselves, likewise. The online copies carry "Do not modify
# this document. Do not include this document in another software product", so
# they are read here and never redistributed; tests/spec/clauses/ holds the
# clause numbers and headings a citation needs and no text at all.
#
# This rule was in .git/info/exclude, which is not committed -- so the whole
# protection lived on one machine and no clone had it.
doc/vendor/
