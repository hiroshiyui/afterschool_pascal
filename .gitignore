build/
# The release process configures a from-scratch tree beside it
# (.claude/skills/release-engineering), and a coverage one beside that
# (.claude/skills/code-review).
build-*/
*.o
*.ll
# ...except the seed, which is a committed compiler and the one thing that lets
# this repository build itself (ADR-0085). It was silently skipped by `git add`
# for one commit, and a clean clone could not be built.
!seed/*.ll
*.s
__pycache__/
*.pyc

# The BSI validation suite is fetched, never committed (tests/bsi/fetch.sh).
tests/bsi/suite/

# The Unicode Character Database, likewise (runtime/unicode/fetch.sh). What is
# committed is what generate.py reads *out* of it --
# runtime/pasrt_unicode_data.h -- which is the artefact a build needs; the
# database is what a refresh needs. Unlike the two below, this is a size and
# provenance decision and not a licensing one: Unicode does permit
# redistribution.
runtime/unicode/ucd/

# The standards themselves, likewise. The online copies carry "Do not modify
# this document. Do not include this document in another software product", so
# they are read here and never redistributed; tests/spec/clauses/ holds the
# clause numbers and headings a citation needs and no text at all.
#
# This rule was in .git/info/exclude, which is not committed -- so the whole
# protection lived on one machine and no clone had it.
doc/vendor/

# What a bound file leaves behind. tests/extended/bind_qualified.pas binds
# `bind_qualified.tmp` by a *relative* name, so running that case by hand from
# the top of the tree writes it here rather than into the build directory --
# and it was committed once, in 7e827ad, because `git add` was given a
# directory and the artifact was sitting in it.
*.tmp

# A background agent gets its own git worktree and this harness puts it inside
# the checkout. It is a second copy of the repository, never part of it.
.claude/worktrees/
