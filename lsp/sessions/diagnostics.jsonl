# The ordinary life of a document: opened with an error in it, changed twice,
# closed. Every publishDiagnostics below is the compiler's own answer, with
# the positions moved to the protocol's zero-based counting.
#
# The byte counts in the golden are part of what is pinned: LspWrite computes
# them from what JsonRender produced, so a change to either fails here.
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{}}}
# A notification, so no response -- and the golden is what says so.
{"jsonrpc":"2.0","method":"initialized","params":{}}

# One error, at line 3 column 11 of the source and 2:10 in the notification.
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///scratch/hello.pas","languageId":"pascal","version":1,"text":"program hello(output);\nbegin\n  writeln(greeting)\nend.\n"}}}

# Two errors in one compilation, which is what says the sweep does not stop at
# the first line it can parse.
{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///scratch/hello.pas","version":2},"contentChanges":[{"text":"program hello(output);\nvar n: integer;\nbegin\n  n := 'x';\n  writeln(undeclared)\nend.\n"}]}}

# A request this server does not implement, which must be answered rather than
# ignored: a client waiting on an id it never gets back is a client that hangs.
# It was `textDocument/hover` until ADR-0246 answered that one and
# `textDocument/completion` until ADR-0301 answered that, which is the reason
# to say what this probe is for rather than which method it names: the method
# here is whichever one is still unimplemented, and what is asserted is the
# -32601 and not anything about signature help.
{"jsonrpc":"2.0","id":2,"method":"textDocument/signatureHelp","params":{"textDocument":{"uri":"file:///scratch/hello.pas"},"position":{"line":0,"character":0}}}

# Interleaved between the two edits on purpose (ADR-0257). Two didChange
# messages for one file arriving back to back are coalesced -- only the last
# is compiled, because a keystroke carries the whole document and the answer
# to an earlier one is stale before it could be published. This session is
# about what a *diagnostic* looks like after each edit, so the edits are kept
# apart by a request; `coalesce.jsonl` is where the drain itself is pinned.
# Fixed. The empty array is not silence: it is how the client is told the
# problems it was showing are gone.
{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///scratch/hello.pas","version":3},"contentChanges":[{"text":"program hello(output);\nbegin\n  writeln('hello')\nend.\n"}]}}


{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"file:///scratch/hello.pas"}}}
{"jsonrpc":"2.0","id":3,"method":"shutdown"}
{"jsonrpc":"2.0","method":"exit"}
