# textDocument/prepareRename and textDocument/rename (ADR-0294): references
# with one TextEdit per row, grouped per file in a WorkspaceEdit's
# `documentChanges`. Every occurrence is edited, the declaration included --
# a rename that left the declaration alone would be a program that no longer
# compiles.
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{"general":{"positionEncodings":["utf-8"]}}}}

{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///scratch/shapes.pas","languageId":"pascal","version":1,"text":"program shapes(output);\n\ntype\n  Point = record\n    x, y: integer\n  end;\n\nvar\n  p: Point;\n  total: integer;\n\nprocedure Bump(var q: Point);\nbegin\n  q.x := q.x + 1;\n  with q do y := y + 1\nend;\n\nbegin\n  total := 0;\n  p.x := total;\n  Bump(p);\n  total := p.x + p.y;\n  writeln(total)\nend.\n"}}}

# What a client asks before it shows the box: the range of the name under
# the cursor and its spelling as written, which is the placeholder.
{"jsonrpc":"2.0","id":2,"method":"textDocument/prepareRename","params":{"textDocument":{"uri":"file:///scratch/shapes.pas"},"position":{"line":21,"character":2}}}

# `total` becomes `sum`: five edits in one file, the declaration first.
{"jsonrpc":"2.0","id":3,"method":"textDocument/rename","params":{"textDocument":{"uri":"file:///scratch/shapes.pas"},"position":{"line":21,"character":2},"newName":"sum"}}

# The field `y`, asked at the bare `y` 6.8.3.10's with-statement admits on
# line 15. Its declaration on line 5 is in no row and is edited by position;
# the other bare `y` and `p.y` on line 22 are the rest.
{"jsonrpc":"2.0","id":4,"method":"textDocument/rename","params":{"textDocument":{"uri":"file:///scratch/shapes.pas"},"position":{"line":14,"character":12},"newName":"depth"}}

# A procedure at its call: the heading's name and the call.
{"jsonrpc":"2.0","id":5,"method":"textDocument/rename","params":{"textDocument":{"uri":"file:///scratch/shapes.pas"},"position":{"line":20,"character":2},"newName":"Nudge"}}

# prepareRename on a declaration itself, which ADR-0250 made an occurrence.
{"jsonrpc":"2.0","id":6,"method":"textDocument/prepareRename","params":{"textDocument":{"uri":"file:///scratch/shapes.pas"},"position":{"line":3,"character":2}}}

{"jsonrpc":"2.0","id":7,"method":"shutdown"}
{"jsonrpc":"2.0","method":"exit"}
