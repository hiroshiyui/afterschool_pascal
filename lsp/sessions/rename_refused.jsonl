{"jsonrpc":"2.0","id":8,"method":"textDocument/prepareRename","params":{"textDocument":{"uri":"file:///scratch/shapes.pas"},"position":{"line":17,"character":2}}}

{"jsonrpc":"2.0","id":9,"method":"textDocument/rename","params":{"textDocument":{"uri":"file:///scratch/shapes.pas"},"position":{"line":17,"character":2},"newName":"x"}}

