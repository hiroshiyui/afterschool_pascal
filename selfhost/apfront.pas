  begin
    fmtRangeLo := 0;
    fmtRangeHi := 0;
    { The sink is open unless a range closes it. `DumpTrivia` copies comment
      text through the same `FmtPut` and never runs `FormatSource`, so a
      default of false silently emptied that dump. }
    fmtEmit := true;
    InstallKeywords;
    level := 0;
    curDeclBlock := nil;
    instDeclTail := nil;
    boundSchemas := nil;
    scopeTop := nil;
    scopeDepth := 0;
    applySeq := 0;
    scopeMark[0] := 0;
    pendingHead := nil;
    pendingTail := nil;
    inTypePart := false;
    withTop := nil;
    recTop := nil;
    forTop := nil;
    producedHead := nil;
    utf8Schema := nil;
    producingTop := nil;
    heapTypes := nil;
    layoutTail := nil;
    genericFor := nil;
    sliceFormNode := nil;
    dynamicVarFor := nil;
    dynBoundsFor := nil;
    variantField := false;
    inSchemaBody := false;
    formalsFor := nil;
    stdInput := nil;
    stdOutput := nil;
    for stringIndex := 1 to strMax do
      stringCache[stringIndex] := nil
  end;

end.
