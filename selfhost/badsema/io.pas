{ read and write: the file argument, the widths, and what may be read. }
program io(input, output);
var i: integer; r: real; c: char; b: boolean; f: text;
function anint: integer; begin anint := 1 end;
begin
  write;
  write(f + f);
  write(i:r);
  write(i:1:2);
  write(r:1:c);
  read;
  read(anint);
  read(b);
  reset(i);
  get(i, i);
  writeln(c)
end.
