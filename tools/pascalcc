# The two markers below delimit what `--help` prints, and they exist because a
# line range did not: it was `sed -n '2,20p'`, which printed the fifteen lines
# of licence above and then stopped one line short of the first option. Every
# option was invisible, and this is the only place `-c`, `-O0..-O3` and
# `<file>.o` are documented at all -- `pascalc -h` is the compiler's help and
# does not know about the half that links. Nothing caught it: producttest.sh
# checks that `pascalc -h` names every flag ParseArgs accepts, and there was no
# such check for the driver. There is now, in the same file.
# >>> usage
# Compile and link a Pascal program with `pascalc`.
#
#   pascalcc [options] file.pas
#
#     -o <file>       the executable, object or IR to write
#     -c              write an object file and stop
#     --emit-llvm,-S  write the IR and stop
#     -O0 .. -O3      optimisation level, handed to clang (default -O2)
#     --std=<name>    accepted and ignored; ADR-0232 removed the modes
#     --target=<t>    the machine to compile for; handed to both halves, so
#                     clang needs a cross toolchain and a --sysroot for it
#     --import <f>    a program-component already translated
#     --import-path <d>  where `pascalc` looks for an interface no --import
#                     gave. Whatever it finds is translated and linked here,
#                     which is the half of resolution a compiler cannot do:
#                     AFTERSCHOOL_PASCAL_PATH is searched too, and needs no
#                     flag at all
#     --coverage      emit statement counters; the compiled program then
#                     writes the lines it ran to $PASCOV_LINES
#     --dump-<what>   any of `pascalc`'s dumps. The answer is its standard
#                     output and nothing is assembled or linked
#     --format        write the source back out with the compiler's own
#                     layout. Standard output again, and nothing is linked
#     -h, --help      write this list and stop
#     <file>.o        an object to link, from a component compiled with -c
#
#   And a project, which is a convenience over the above and never a second
#   way to compile (ADR-0348). Each of these is recognised as the *first*
#   argument and nowhere else, so a file called `build.pas` still compiles:
#
#     new-project <name>  write a skeleton: src/, test/, build/, a
#     new <name>          .gitignore, a README and afterschool-pascal.toml
#     build           compile the program afterschool-pascal.toml names
#     run             build it, then run it; further arguments go to it
#     test            build it, run it, and compare against test.expected
#
#   `afterschool-pascal.toml` is looked for here and in each enclosing
#   directory. It carries what the compiler cannot infer -- which source is
#   the program, where the executable goes, the optimisation level, the
#   target, extra import paths and the link flags -- and deliberately **does
#   not list your modules**: `import greet;` finds `src/greet.pas` by name,
#   so adding a module is adding a file.
#
#   AFTERSCHOOL_PASCAL_CFLAGS adds flags to every `clang` below, which is
#   how a sanitizer reaches the link as well as the translations.
#   AFTERSCHOOL_PASCAL_LDFLAGS adds flags to the final link only, and goes
#   after the runtime, which is where a library a program binds belongs.
# <<< usage
#
# `pascalc` writes LLVM IR and stops there, permanently: neither ISO 7185 nor
# ISO/IEC 10206:1991 has process control, so a compiler written in Pascal
# cannot start an assembler. That is a property of the language rather than a
# shortfall, and this is where the missing half lives -- everything below the
# IR is `clang`, and this script is the seam.
#
# It exists because four harnesses need that seam and would otherwise each grow
# their own: tests/run_test.sh, selfhost/irtest.sh, selfhost/producttest.sh and
# verify/verify.py. Giving them one command line shaped like the C++ driver's
# is what let them keep their logic when stage 0 was retired.
#
# Everything it does not pass on it refuses. A driver that silently ignored an
# option would make a harness look like it had tested something it had not.
set -u

self=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$self")

# **Where everything is, when this has been installed somewhere** (ADR-0244).
# Three places are looked at and the order is the decision: what the
# environment names, then what is beside this script, then the build tree this
# script sits in. A checkout is the third and is unaffected -- `tools/pascalc`
# is not a file -- and an installed copy at <prefix>/bin finds its compiler
# next to itself with nothing configured, which is what makes `pascalcc` on
# PATH enough.
#
# The compiler is *not* looked for on PATH itself. A pascalcc and a pascalc
# from different releases would then be paired by whatever order a user's PATH
# happens to have, and the pairing is the one thing this script is: it hands
# the IR of one to the clang of the other.
pascalc=${PASCALC:-}
if [[ -z $pascalc ]]; then
  if [[ -x $self/pascalc ]]; then pascalc=$self/pascalc
  else pascalc=$root/build/bin/pascalc
  fi
fi
# Extra flags for every `clang` this script runs, word-split from
# AFTERSCHOOL_PASCAL_CFLAGS. Empty and absent are the same thing, which is why
# the array is expanded with the `${a[@]+...}` guard the other lists here use:
# an unset array under `set -u` is an error and an empty one must add no
# argument at all.
#
# It exists for `tests/checks/sanitize.sh` (ADR-0259) and is deliberately a
# blunt instrument: a sanitizer has to reach the *link* as well as every
# translation, because that is where its runtime is pulled in, and there was no
# seam for that. It is not a general "pass anything to the compiler" door --
# `pascalc` takes its own flags and this reaches only the assembler and linker
# half, which is the half this script owns.
read -r -a extra_cflags <<<"${AFTERSCHOOL_PASCAL_CFLAGS:-}"
# ...and the same for the *link* alone.
#
# It exists because AFTERSCHOOL_PASCAL_CFLAGS is deliberately blunt and a
# library is not: `-lssl` handed to a `clang -c` is an input clang has nothing
# to do with, and it says so once per translation. A program binding a foreign
# library (6.7.7) needs the flag in exactly one place, and this is that place.
# Appended *after* `libpasrt.a`, because a static archive is searched once and
# only satisfies what has already been referenced.
read -r -a extra_ldflags <<<"${AFTERSCHOOL_PASCAL_LDFLAGS:-}"
runtime=${AFTERSCHOOL_PASCAL_RUNTIME:-}
if [[ -z $runtime ]]; then
  if [[ -f $root/lib/libpasrt.a ]]; then runtime=$root/lib
  else runtime=$root/build/lib
  fi
fi
# ...and where the library went. Only when nothing was said: a user who sets
# AFTERSCHOOL_PASCAL_PATH is describing their whole search path, and appending
# to it would make an installed module shadow one of theirs by a rule they
# never wrote. Two directories because the tree has two, and lib/dialect/ is
# separate for a reason that is now documentary (ADR-0121 decision 5) rather
# than a second language.
installed_lib=
if [[ -z ${AFTERSCHOOL_PASCAL_PATH:-} && -d $root/lib/afterschool ]]; then
  installed_lib=$root/lib/afterschool
fi

die() { echo "pascalcc: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# A project: `new-project`, `build`, `run` and `test` (ADR-0348)
# ---------------------------------------------------------------------------
#
# **Intercepted as `$1` and nowhere else**, which is ADR-0140's spelling rule
# applied to a command line: a source file is `something.pas` and an object is
# `something.o`, so a bare word in the first position is a shape no existing
# invocation has. `pascalcc build.pas` still compiles a file called that.
#
# **What a project file is for, and what it must not become.** The import graph
# stays *inferred*: `import greet;` finds `src/greet.pas` because ADR-0244
# looks in the source's own directory, and no key here lists a module. Listing
# them would undo the property `doc/tour.md` is written around -- there is no
# manifest and no build order to maintain -- and a generator that invented one
# would be adding back what the design removed. What the file carries is what
# the compiler cannot infer and a person has to remember instead: which source
# is the program, where the executable goes, the optimisation level, the
# target, extra import paths, and the **link flags** a program binding a
# foreign library needs. That last is the sharp one -- a program using
# `PasTls` must today know to set AFTERSCHOOL_PASCAL_LDFLAGS=-lssl -lcrypto,
# and nothing tells it so.

proj_file=afterschool-pascal.toml

# The TOML subset, and it is a subset on purpose: `[section]`, `key = "string"`,
# `key = ["a", "b"]`, `#` to end of line, and nothing else. No integers, no
# booleans, no nesting, no multi-line strings.
#
# **It refuses what it does not understand**, naming the line, because that is
# this script's rule everywhere else -- a driver that silently ignored an
# option would be a driver that lies about what it did. A misspelled key in a
# build file is exactly the defect that is otherwise found by the build being
# subtly wrong.
proj_read() {                     # proj_read <file>; sets proj_<key> variables
  local file=$1 out
  out=$(awk -v FS='' '
    function die(msg) { printf("pascalcc: %s:%d: %s\n", FILENAME, NR, msg) > "/dev/stderr"; exit 1 }
    { line = $0 }
    { sub(/[ \t]*#.*$/, "", line); sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line) }
    line == "" { next }
    line ~ /^\[[a-z]+\]$/ {
      section = substr(line, 2, length(line) - 2)
      if (section != "project" && section != "build" && section != "test")
        die("unknown section [" section "]")
      next
    }
    {
      if (section == "") die("a key outside any [section]")
      eq = index(line, "=")
      if (eq == 0) die("not a key = value line")
      key = substr(line, 1, eq - 1); val = substr(line, eq + 1)
      sub(/[ \t]+$/, "", key); sub(/^[ \t]+/, "", val)
      full = section "." key
      if (full != "project.name" && full != "project.version" &&
          full != "build.program" && full != "build.output" &&
          full != "build.opt" && full != "build.target" &&
          full != "build.import-path" && full != "build.cflags" &&
          full != "build.ldflags" && full != "test.expected")
        die("unknown key " full)
      gsub(/-/, "_", key)
      name = "proj_" section "_" key
      if (val ~ /^\[.*\]$/) {
        inner = substr(val, 2, length(val) - 2)
        n = split(inner, parts, ",")
        printf("%s=()\n", name)
        for (i = 1; i <= n; i++) {
          p = parts[i]
          sub(/^[ \t]+/, "", p); sub(/[ \t]+$/, "", p)
          if (p == "") continue
          if (p !~ /^".*"$/) die("an array holds quoted strings")
          printf("%s+=(%s)\n", name, "\047" substr(p, 2, length(p) - 2) "\047")
        }
      } else if (val ~ /^".*"$/) {
        printf("%s=%s\n", name, "\047" substr(val, 2, length(val) - 2) "\047")
      } else die("a value is a quoted string or an array of them")
    }
  ' "$file") || exit 1
  eval "$out"
}

# Find the project file here or in an enclosing directory, and `cd` there, so
# `pascalcc build` works from anywhere inside a project the way `git` does.
proj_find() {
  local d=$PWD
  while [[ $d != / ]]; do
    if [[ -f $d/$proj_file ]]; then printf '%s\n' "$d"; return 0; fi
    d=$(dirname "$d")
  done
  die "no $proj_file here or above -- 'pascalcc new-project <name>' writes one"
}

# The skeleton. Four directories and a file each, and every one of them earns
# itself: `src/` is where the import search already looks, so a module beside
# the program needs no path and no declaration; `test/` holds the golden the
# `test` subcommand compares against; `build/` is where artefacts go and is
# the only thing in `.gitignore` that matters.
proj_new() {
  local name=$1 dir=$1
  [[ $name =~ ^[A-Za-z][A-Za-z0-9_]*$ ]] ||
    die "a project name is a Pascal identifier: letters, digits and _, not starting with a digit"
  [[ ! -e $dir ]] || die "'$dir' already exists"

  mkdir -p "$dir/src" "$dir/test" "$dir/build"

  cat > "$dir/$proj_file" <<EOF
# What this project is, and what building it needs. The compiler works out the
# rest: \`import greet;\` finds src/greet.pas by name, so no module is listed
# here and no build order is maintained anywhere.

[project]
name    = "$name"
version = "0.1.0"

[build]
program     = "src/$name.pas"
output      = "build/$name"
opt         = "-O2"
import-path = ["src"]
# target  = "x86_64-pc-linux-gnu"
# cflags  = []
# ldflags = ["-lssl", "-lcrypto"]   # a program binding PasTls needs these

[test]
expected = "test/$name.out"
EOF

  cat > "$dir/src/$name.pas" <<EOF
{ $name -- written by \`pascalcc new-project\`.

  The import below resolves by name: \`greet\` is src/greet.pas, in this
  source's own directory, and nothing had to say so. }
program $name(output);

import greet;

begin
  writeln(Greeting('world'))
end.
EOF

  cat > "$dir/src/greet.pas" <<'EOF'
{ A module, so that the program beside it has something to import. A
  module-heading *is* the interface: what is not exported here cannot be
  reached, and there is no second file saying so. }
module greet;

export greet = (Greeting);

function Greeting(who: string): string(64);

end;

function Greeting;
begin
  Greeting := 'Hello, ' + who + '!'
end;

end.
EOF

  printf 'Hello, world!\n' > "$dir/test/$name.out"

  cat > "$dir/.gitignore" <<'EOF'
build/
*.ll
*.o
EOF

  cat > "$dir/README.md" <<EOF
# $name

\`\`\`sh
pascalcc build      # writes build/$name
pascalcc run        # builds, then runs it
pascalcc test       # builds, runs, and compares against test/$name.out
\`\`\`

Each reads \`$proj_file\`, which says which source is the program, where the
executable goes and what the link needs. **It does not list your modules.**
\`import greet;\` finds \`src/greet.pas\` because the compiler looks in the
importing source's own directory and then in each \`import-path\` -- so adding
a module is adding a file, and there is no build order to maintain.

| | |
| --- | --- |
| \`src/\` | your program and its modules |
| \`test/\` | the output \`pascalcc test\` expects |
| \`build/\` | artefacts, and the only thing in \`.gitignore\` that matters |

\`pascalcc\` still takes a file directly -- \`pascalcc src/$name.pas -o $name\`
-- and a project is a convenience over that, never a different compiler.
EOF

  echo "pascalcc: wrote $dir/"
  echo "  cd $dir && pascalcc run"
}

# `build`, `run` and `test`, and the whole of what they do is assemble a
# command line this script already accepted. That is deliberate: a project is a
# convenience over `pascalcc file.pas`, never a second way to compile, so
# anything one of these can do a person can do by hand and see how.
proj_build() {
  local dir; dir=$(proj_find) || exit 1
  cd "$dir" || die "cannot enter $dir"
  proj_build_name= proj_build_program= proj_build_output= proj_build_opt=
  proj_build_target= proj_project_name= proj_project_version= proj_test_expected=
  proj_build_import_path=() proj_build_cflags=() proj_build_ldflags=()
  proj_read "$proj_file"

  [[ -n ${proj_build_program:-} ]] || die "$proj_file names no build.program"
  [[ -f ${proj_build_program} ]] ||
    die "build.program is '${proj_build_program}', which is not a file"
  local out=${proj_build_output:-build/${proj_project_name:-a.out}}
  mkdir -p "$(dirname "$out")"

  local args=()
  [[ -n ${proj_build_opt:-} ]] && args+=("${proj_build_opt}")
  [[ -n ${proj_build_target:-} ]] && args+=("--target=${proj_build_target}")
  local p
  for p in ${proj_build_import_path[@]+"${proj_build_import_path[@]}"}; do
    args+=(--import-path "$p")
  done

  # The two flag lists reach `clang` the way the environment variables do, and
  # through the same two seams (ADR-0264) -- appended to whatever the caller
  # already set rather than replacing it, so a sanitizer run over a project
  # keeps its flags.
  AFTERSCHOOL_PASCAL_CFLAGS="${AFTERSCHOOL_PASCAL_CFLAGS:-} ${proj_build_cflags[*]+${proj_build_cflags[*]}}" \
  AFTERSCHOOL_PASCAL_LDFLAGS="${AFTERSCHOOL_PASCAL_LDFLAGS:-} ${proj_build_ldflags[*]+${proj_build_ldflags[*]}}" \
    "$0" ${args[@]+"${args[@]}"} "${proj_build_program}" -o "$out" || exit 1
  # Set rather than printed. It was printed once, and `out=$(proj_build)` put
  # the whole of it in a subshell -- so `test` read the config, built, and then
  # found none of the keys the *subshell* had set. A function that both does
  # the work and answers a value has to answer it in a variable here.
  proj_out=$out
}

proj_run() {
  proj_build
  "./$proj_out" "$@"
}

# The third subcommand, and it is what makes `test/` mean something. A project
# with a golden nothing compares it against would be a directory the generator
# invented, which is the shape this whole feature is written against.
proj_test() {
  proj_build
  local out=$proj_out want=${proj_test_expected:-}
  [[ -n $want ]] || die "$proj_file names no test.expected"
  [[ -f $want ]] || die "test.expected is '$want', which is not a file"
  local got; got=$(mktemp)
  if ! "./$out" > "$got" 2>&1; then
    echo "pascalcc: $out exited non-zero" >&2
    cat "$got" >&2; rm -f "$got"; exit 1
  fi
  if diff -u "$want" "$got"; then
    rm -f "$got"; echo "pascalcc: test ok"
  else
    rm -f "$got"; die "output differs from $want"
  fi
}

case ${1:-} in
  new-project|new)
    [[ $# -eq 2 ]] || die "usage: pascalcc new-project <name>"
    proj_new "$2"; exit 0 ;;
  build) [[ $# -eq 1 ]] || die "'build' takes no arguments"
         proj_build; printf '%s\n' "$proj_out"; exit 0 ;;
  run)   shift; proj_run "$@"; exit $? ;;
  test)  [[ $# -eq 1 ]] || die "'test' takes no arguments"
         proj_test; exit 0 ;;
esac

out=
mode=link          # link | object | ir
opt=-O2
# Empty unless --target= was given, or AFTERSCHOOL_PASCAL_TARGET names one:
# unset leaves `pascalc` on its own default, which is x86-64, and leaves clang
# on the machine this is running on.
#
# The environment variable is how a *whole run* is pointed at one target, the
# way AFTERSCHOOL_PASCAL_OPT points one at an optimisation level, and it exists
# for the same reason: the harnesses drive this script one program at a time and
# have nowhere to put a flag. What it buys is the arm64 CI job -- without it
# that job would run 638 programs through a compiler emitting an x86-64 header
# for clang to override, which passes and says nothing about the aarch64 arm
# ADR-0156 added. An explicit --target= wins, since a case that names a target
# means it.
target=${AFTERSCHOOL_PASCAL_TARGET:+--target=$AFTERSCHOOL_PASCAL_TARGET}
source_file=
covflag=()
dumps=()
imports=()
paths=()
objects=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -o)            [[ $# -ge 2 ]] || die "-o needs a file name"; out=$2; shift 2 ;;
    -c)            mode=object; shift ;;
    --emit-llvm|-S) mode=ir; shift ;;
    -O0|-O1|-O2|-O3) opt=$1; shift ;;
    # ADR-0232 removed the modes; the flag is accepted and ignored so that a
    # caller's script does not break on the release that removes it.
    --std=*)       shift ;;
    # Handed to *both* halves and validated by neither here: `pascalc` refuses
    # a target it has no layout for, and clang refuses one it cannot find a
    # toolchain for, so a wrong spelling is reported by whichever knows why
    # rather than by a third opinion in this script (ADR-0156).
    --target=*)    target=$1; shift ;;
    --import)      [[ $# -ge 2 ]] || die "--import needs a file name"
                   imports+=(--import "$2"); shift 2 ;;
    --import-path) [[ $# -ge 2 ]] || die "--import-path needs a directory"
                   paths+=(--import-path "$2"); shift 2 ;;
    --coverage)    covflag=(--coverage); shift ;;
    # ADR-0239's --dump-symbols and the flags beside it, and ADR-0279's
    # --format. Passed through to `pascalc` and nothing else happens: see
    # below. `--format` is not a dump and is in the same list for the same
    # reason -- what it writes is the compiler's standard output and no IR.
    --dump-*|--format)
                   dumps+=("$1"); shift ;;
    --help|-h)     sed -n '/^# >>> usage$/,/^# <<< usage$/p' "$0" |
                     sed '1d; $d; s/^#\( \|$\)//'
                   exit 0 ;;
    -*)            die "unknown option '$1'" ;;
    *.o)           objects+=("$1"); shift ;;
    *)             [[ -z $source_file ]] || die "more than one input file given"
                   source_file=$1; shift ;;
  esac
done

[[ -n $source_file ]] || die "no input file"

# An i386 this compiler emits for has SSE2, and this is where that is said
# (ADR-0346). The IR is unaffected -- a `double` is a double in it whatever the
# processor -- so nothing about this reaches `pascalc`; what needs saying is
# which x86 the assembler generates for, and clang's default answer for this
# triple is `i686`, whose x87 registers are eighty bits wide.
#
# Two things break on those eighty bits, both of them requirements rather than
# preferences. 6.7.6.3 defines `round(x)` as equivalent to `trunc(x +- 0.5)`,
# and the two disagree at -0.49999999999999994 where the sum is exactly -1.0 as
# a double and a shade above -1 in a register. And D.32 makes `sqr(x)` yielding
# a value the type does not have an *error*, which is checked by asking whether
# the result is infinite -- and a fifteen-bit exponent makes `sqr(-1e200)` an
# ordinary finite number, so the check does not fire and the program prints
# where every other target here stops. A missed error condition is not
# something a dialect aiming at modern computing gets to have on one target.
#
# `pentium4` rather than `-msse2 -mfpmath=sse`: it is one flag, it is what a
# current clang already defaults to for this triple, and it names a processor
# rather than a pair of code-generation switches. `tests/checks/target32.sh`
# builds a runtime with direct clang calls and says the same thing there; the
# two are the only places, and each names the other.
cpu=()
case $target in
  *=i386-pc-linux-gnu) cpu=(-march=pentium4) ;;
esac

# The installed library goes on the end, after whatever --import-path the
# caller wrote: the search takes the first directory holding the file, so a
# caller's own copy of a module has to be looked at first or the flag would
# mean nothing where it matters most.
if [[ -n $installed_lib ]]; then
  paths+=(--import-path "$installed_lib" --import-path "$installed_lib/dialect")
fi
[[ -x $pascalc ]] || die "$pascalc is not executable -- was it built?"

# A --dump flag, and --format, ask the *compiler* for something and the answer
# is its standard output. Nothing this script adds -- the assembler, the linker, the runtime --
# has anything to do with one, and a flag that stops at a stage writes no IR at
# all, so the `wrote no IR` check below would refuse a correct run. The dump is
# passed through rather than folded into this script's stderr the way a
# diagnostic is: a diagnostic is a complaint and a dump is a product.
#
# It exists because `lsp/pasls.pas` answers documentSymbol out of
# --dump-symbols and a user may just as well name this script in
# PASLS_COMPILER as name `pascalc` -- and did, and got an empty outline back
# with `pascalcc: unknown option` in a stream nothing was reading. `--format`
# arrived the same way and was caught the same way: the server's own session
# suite drives it through this script, and the first run of it answered with
# no edits at all (ADR-0279).
if [[ ${#dumps[@]} -gt 0 ]]; then
  "$pascalc" ${target:+"$target"} "${dumps[@]}" \
    "${covflag[@]+"${covflag[@]}"}" "$source_file" \
    "${imports[@]+"${imports[@]}"}" "${paths[@]+"${paths[@]}"}" \
    -o "${out:-/dev/null}"
  exit $?
fi

base=$(basename "${source_file%.pas}")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# **Resolution gives an interface; this gives an object** (ADR-0244). `pascalc`
# finds the file that supplies an `import` name and reads its heading, and
# something still has to translate that file and link the result -- which is
# this script, because it is the half of the compiler that links.
#
# `--dump-imports` is how it is told, in the compiler's own words and in
# activation order. Reading the Pascal here to work it out is the mistake
# ADR-0229, ADR-0230 and ADR-0239 each moved something off, and it would be a
# worse one in a shell script.
#
# The `grep` is not a reader of Pascal and must not become one: it is a
# *necessary condition* asked cheaply, since a source with no `import` anywhere
# in it has no import-part and nothing to resolve. A false positive -- the word
# in a comment or a string -- costs one parse and nothing else, and a false
# negative is impossible. Without it every case in a 700-program corpus would
# pay for a question about a program that imports nothing.
resolved=()
if grep -qiw import "$source_file" 2>/dev/null; then
  while IFS= read -r line; do
    [[ $line == component\ * ]] || continue
    resolved+=("${line#component }")
  done < <("$pascalc" ${target:+"$target"} "$source_file" \
             "${imports[@]+"${imports[@]}"}" "${paths[@]+"${paths[@]}"}" \
             --dump-imports -o /dev/null 2>/dev/null)
fi

# Each of them translated and assembled, in the order given -- which is
# dependency order, so a component's own interfaces are resolved by the
# compiler the same way the program's were. A component the caller already
# named with --import is skipped: its object is the caller's to supply, and
# tests/run_test.sh supplies one.
n=0
for c in "${resolved[@]+"${resolved[@]}"}"; do
  skip=
  for k in "${imports[@]+"${imports[@]}"}"; do
    [[ $k == "$c" ]] && skip=yes
  done
  [[ -z $skip ]] || continue
  n=$((n + 1))
  if ! "$pascalc" ${target:+"$target"} \
       "${covflag[@]+"${covflag[@]}"}" "$c" \
       "${paths[@]+"${paths[@]}"}" \
       -o "$work/c$n.ll" >"$work/c$n.txt" 2>&1; then
    cat "$work/c$n.txt" >&2
    die "component '$c' did not translate"
  fi
  cat "$work/c$n.txt" >&2
  clang ${target:+"$target"} ${cpu[@]+"${cpu[@]}"} -Wno-override-module "$opt" ${extra_cflags[@]+"${extra_cflags[@]}"} -fPIC -c \
    "$work/c$n.ll" -o "$work/c$n.o" || die "component '$c' did not assemble"
  objects+=("$work/c$n.o")
done

# The IR first. `pascalc` writes its diagnostics to standard *output* -- no
# standard Pascal program has a second stream -- so they are passed through to
# this script's stderr, which is where a caller expects a compiler's complaints
# and where the golden .err files are compared from.
ir=$work/$base.ll
if ! "$pascalc" ${target:+"$target"} \
     "${covflag[@]+"${covflag[@]}"}" "$source_file" \
     "${imports[@]+"${imports[@]}"}" "${paths[@]+"${paths[@]}"}" \
     -o "$ir" >"$work/diag.txt" 2>&1; then
  cat "$work/diag.txt" >&2
  exit 1
fi
cat "$work/diag.txt" >&2
[[ -s $ir ]] || die "$pascalc exited 0 and wrote no IR"

if [[ $mode == ir ]]; then
  cp "$ir" "${out:-$base.ll}"
  exit 0
fi

# -Wno-override-module: the IR names its own target triple, which clang would
# otherwise warn about when it agrees with its own.
if [[ $mode == object ]]; then
  exec clang ${target:+"$target"} ${cpu[@]+"${cpu[@]}"} -Wno-override-module "$opt" ${extra_cflags[@]+"${extra_cflags[@]}"} -fPIC -c "$ir" \
       -o "${out:-$base.o}"
fi

# The link is also where a **component from a different compiler** surfaces,
# and it is the one link failure worth translating. A module's two activation
# functions carry a language tag in their names (ADR-0119), so an object left
# over from a release that still had the conformance modes leaves this
# program's symbol undefined. That is the correct outcome and an unreadable way
# to say it: `undefined reference to 'm.pastext.afterschool.init'` names what
# the *program* wanted, not what the object has, and a reader has no reason to
# know the convention.
#
# ADR-0232 left one tag where there were three, so this can no longer fire
# between two objects of the same release -- what it now reports is a stale
# `.o`, which is exactly the case a reader is least equipped to diagnose.
#
# Only the diagnosis is added -- the linker's own output is passed through
# first, and the exit status is still a failure. A driver that turned a link
# error into something else would be the silent-ignoring this script's header
# refuses.
if clang ${target:+"$target"} ${cpu[@]+"${cpu[@]}"} -Wno-override-module "$opt" ${extra_cflags[@]+"${extra_cflags[@]}"} "$ir" \
     "${objects[@]+"${objects[@]}"}" "$runtime/libpasrt.a" -lm -pthread \
     ${extra_ldflags[@]+"${extra_ldflags[@]}"} \
     -o "${out:-$base}" 2>"$work/link.txt"; then
  exit 0
fi
cat "$work/link.txt" >&2
# A module's activation functions carry two facts the components of one program
# must agree on: the language (ADR-0119) and, since ADR-0245, a digest of the
# module-*heading* they were translated against. Either disagreement is an
# undefined reference to a name a reader has no reason to be able to decode, so
# it is decoded here.
#
# The two cases are told apart by whether the missing name has a digest in it.
# A name without one comes from a release that predates the digest; a name with
# one means the object was built from a *different heading* than the one this
# program was compiled against -- which is the stale-object hazard
# doc/implementation-defined.md 2.5 recorded as detected by nothing, and which
# silently produced a wrong answer rather than a diagnostic.
mismatch=$(sed -n "s/.*undefined reference to .m\.\([A-Za-z0-9_]*\)\.\(extended\|afterschool\)\.\([0-9a-f]*\)\.\(init\|fini\).*/\1 \2 \3/p" \
           "$work/link.txt" | head -1)
if [[ -n $mismatch ]]; then
  set -- $mismatch
  echo "pascalcc: error: module '$1' was translated from a different" >&2
  echo "pascalcc: module-heading than the one this program was compiled" >&2
  echo "pascalcc: against. The interface is the heading (§6.11.1), so an" >&2
  echo "pascalcc: object built before it changed agrees about every name and" >&2
  echo "pascalcc: about nothing else -- which is why the digest '$3' is in" >&2
  echo "pascalcc: the symbol and why this is a link error rather than a" >&2
  echo "pascalcc: wrong answer (ADR-0245)." >&2
  echo "pascalcc: recompile '$1'." >&2
else
  mismatch=$(sed -n "s/.*undefined reference to .m\.\([A-Za-z0-9_]*\)\.\(extended\|afterschool\)\.\(init\|fini\).*/\1 \2/p" \
             "$work/link.txt" | head -1)
  if [[ -n $mismatch ]]; then
    set -- $mismatch
    echo "pascalcc: error: module '$1' was translated by a different compiler" >&2
    echo "pascalcc: this program wants 'm.$1.$2.<digest>.init', and the object" >&2
    echo "pascalcc: it was linked against defines a name with no digest in it." >&2
    echo "pascalcc: A component built before ADR-0245 carries no digest, and" >&2
    echo "pascalcc: one built before ADR-0232 carries the conformance mode in" >&2
    echo "pascalcc: that position instead (ADR-0119)." >&2
    echo "pascalcc: recompile '$1' with this pascalc." >&2
  fi
fi
exit 1
